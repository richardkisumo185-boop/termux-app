/**
 * Tanganyika Server - Express + SQLite (ESM)
 * Run:
 *   cd server
 *   npm install
 *   npm start
 */
import express from 'express';
import cors from 'cors';
import bodyParser from 'body-parser';
import path from 'path';
import { fileURLToPath } from 'url';
import sqlite3 from 'sqlite3';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const dbPath = path.join(__dirname, 'data.db');

const sqlite = sqlite3.verbose();
const db = new sqlite.Database(dbPath);

function initDb() {
  db.serialize(() => {
    db.run(`CREATE TABLE IF NOT EXISTS destinations (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, description TEXT)`);
    db.run(`CREATE TABLE IF NOT EXISTS transports (id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, name TEXT, route TEXT, price REAL)`);
    db.run(`CREATE TABLE IF NOT EXISTS operators (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, phone TEXT, email TEXT, fee REAL)`);
    db.run(`CREATE TABLE IF NOT EXISTS bookings (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, destination TEXT, transport TEXT, days INTEGER, travelers INTEGER, type TEXT, insurance INTEGER, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);
  });
}

function seedData() {
  db.serialize(() => {
    db.run("DELETE FROM destinations");
    db.run("DELETE FROM transports");
    db.run("DELETE FROM operators");

    db.run("INSERT INTO destinations (name, description) VALUES (?,?)", ['Serengeti','Witness the Great Migration and incredible wildlife.']);
    db.run("INSERT INTO destinations (name, description) VALUES (?,?)", ['Zanzibar','Relax on white sandy beaches and explore Stone Town.']);

    db.run("INSERT INTO transports (type,name,route,price) VALUES (?,?,?,?)", ['Flight','Air Tanzania','Dar es Salaam → Zanzibar',120]);
    db.run("INSERT INTO transports (type,name,route,price) VALUES (?,?,?,?)", ['Bus','Dar Express','Dar es Salaam → Arusha',25]);
    db.run("INSERT INTO transports (type,name,route,price) VALUES (?,?,?,?)", ['Train','TAZARA','Dar es Salaam → Mwanza',50]);

    db.run("INSERT INTO operators (name,phone,email,fee) VALUES (?,?,?,?)", ['Safari Tours Ltd','+255712345678','info@safaritours.co.tz',50]);
    db.run("INSERT INTO operators (name,phone,email,fee) VALUES (?,?,?,?)", ['Zanzibar Adventures','+255755123456','contact@zanzibaradventures.com',70]);
  });
}

initDb();
seedData();

const app = express();
app.use(cors());
app.use(bodyParser.json());

app.get('/api/destinations', (req, res) => {
  db.all('SELECT * FROM destinations', (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

app.get('/api/transports', (req, res) => {
  db.all('SELECT * FROM transports', (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

app.get('/api/operators', (req, res) => {
  db.all('SELECT * FROM operators', (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

app.post('/api/bookings', (req, res) => {
  const { name, destination, transport, days, travelers, type, insurance } = req.body;
  const stmt = db.prepare('INSERT INTO bookings (name,destination,transport,days,travelers,type,insurance) VALUES (?,?,?,?,?,?,?)');
  stmt.run(name, destination, transport, days, travelers, type, insurance ? 1 : 0, function(err) {
    if (err) return res.status(500).json({ error: err.message });
    const bookingId = this.lastID;
    db.get('SELECT price FROM transports WHERE name = ?', [transport], (err, row) => {
      const transportPrice = row ? row.price : 0;
      const transportCost = transportPrice * travelers;
      const insuranceCost = insurance ? 20 * travelers : 0;
      const total = transportCost + insuranceCost;
      const activities = [];
      for (let i=1;i<=days;i++) activities.push(`Day ${i}: Explore ${destination} (suggested activity)`);
      const itinerary = { id: bookingId, name, destination, transport, days, travelers, type, insurance, insuranceCost, transportCost, total, activities };
      res.json({ bookingId, itinerary });
    });
  });
});

// Serve client in production build (optional)
const clientPath = path.join(__dirname, '..', 'client', 'dist');
app.use(express.static(clientPath));
app.get('*', (req, res) => {
  res.sendFile(path.join(clientPath, 'index.html'));
});

const port = process.env.PORT || 4000;
app.listen(port, () => {
  console.log(`Server running on port ${port}`);
});
JS

