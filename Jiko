import React, { useEffect, useState } from 'react';
import { BrowserRouter as Router, Routes, Route, Link } from 'react-router-dom';
import axios from 'axios';
import { jsPDF } from 'jspdf';

const api = axios.create({ baseURL: 'http://localhost:4000/api' });

function Header() {
  return (
    <nav className="flex flex-wrap gap-4 p-4 bg-green-600 text-white">
      <Link to="/">Home</Link>
      <Link to="/destinations">Destinations</Link>
      <Link to="/transports">Transport</Link>
      <Link to="/operators">Operators</Link>
      <Link to="/booking">Booking</Link>
    </nav>
  );
}

function Footer() { return <footer className="bg-gray-800 text-white p-4 text-center mt-6">Tanganyika Travelers Portal © 2025</footer>; }

function Home() {
  return (
    <div className="p-6">
      <Header />
      <div className="text-center mt-8">
        <h1 className="text-4xl font-bold text-green-700">Karibu Tanganyika Travelers Portal</h1>
        <p className="mt-4 text-gray-700">Discover top destinations and book your trip.</p>
      </div>
      <Footer />
    </div>
  );
}

function Destinations() {
  const [data, setData] = useState([]);
  useEffect(()=>{ api.get('/destinations').then(r=>setData(r.data)); },[]);
  return (
    <div className="p-6">
      <Header />
      <h2 className="text-2xl font-bold mb-4">Destinations</h2>
      <div className="grid md:grid-cols-2 gap-4">
        {data.map(d=>(
          <div key={d.id} className="bg-white p-4 rounded shadow">
            <h3 className="font-semibold">{d.name}</h3>
            <p className="text-sm">{d.description}</p>
          </div>
        ))}
      </div>
      <Footer />
    </div>
  );
}

function Transports() {
  const [data, setData] = useState([]);
  useEffect(()=>{ api.get('/transports').then(r=>setData(r.data)); },[]);
  return (
    <div className="p-6">
      <Header />
      <h2 className="text-2xl font-bold mb-4">Transports</h2>
      <div className="grid md:grid-cols-2 gap-4">
        {data.map(t=>(
          <div key={t.id} className="bg-white p-4 rounded shadow">
            <h3 className="font-semibold">{t.type}: {t.name}</h3>
            <p>Route: {t.route}</p>
            <p>Price: ${t.price}</p>
          </div>
        ))}
      </div>
      <Footer />
    </div>
  );
}

function Operators() {
  const [data, setData] = useState([]);
  useEffect(()=>{ api.get('/operators').then(r=>setData(r.data)); },[]);
  return (
    <div className="p-6">
      <Header />
      <h2 className="text-2xl font-bold mb-4">Operators</h2>
      <div className="grid md:grid-cols-2 gap-4">
        {data.map(o=>(
          <div key={o.id} className="bg-white p-4 rounded shadow">
            <h3 className="font-semibold">{o.name}</h3>
            <p>Contact: {o.phone} | {o.email}</p>
            <p>Fee: ${o.fee}</p>
          </div>
        ))}
      </div>
      <Footer />
    </div>
  );
}

function Booking() {
  const [destinations, setDestinations] = useState([]);
  const [transports, setTransports] = useState([]);
  const [form, setForm] = useState({
    name: '', destination: '', transport: '', days:1, travelers:1, type:'tourism', insurance:false
  });
  const [itinerary, setItinerary] = useState(null);

  useEffect(()=>{ api.get('/destinations').then(r=>setDestinations(r.data)); api.get('/transports').then(r=>setTransports(r.data)); },[]);

  const submit = async () => {
    if(!form.name || !form.destination || !form.transport) return alert('Fill required fields');
    try {
      const res = await api.post('/bookings', form);
      setItinerary(res.data.itinerary);
    } catch (err) {
      alert('Booking failed');
    }
  };

  const downloadPDF = () => {
    if(!itinerary) return;
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('Tanganyika Itinerary', 10, 10);
    doc.setFontSize(12);
    doc.text(`Name: ${itinerary.name}`, 10, 20);
    doc.text(`Destination: ${itinerary.destination}`, 10, 30);
    doc.text(`Transport: ${itinerary.transport}`, 10, 40);
    doc.text(`Days: ${itinerary.days}`, 10, 50);
    doc.text(`Travelers: ${itinerary.travelers}`, 10, 60);
    doc.text(`Insurance: $${itinerary.insuranceCost}`, 10, 70);
    doc.text(`Transport Cost: $${itinerary.transportCost}`, 10, 80);
    doc.text(`Total: $${itinerary.total}`, 10, 90);
    doc.text('Activities:', 10, 100);
    itinerary.activities.forEach((a,i)=>doc.text(`${i+1}. ${a}`, 10, 110 + i*8));
    doc.save('itinerary.pdf');
  };

  return (
    <div className="p-6">
      <Header />
      <div className="max-w-md mx-auto bg-white p-4 rounded shadow">
        <h2 className="text-xl font-bold mb-2">Book Your Trip</h2>
        <input className="border p-2 w-full mb-2" placeholder="Your Name" value={form.name} onChange={e=>setForm({...form,name:e.target.value})} />
        <select className="border p-2 w-full mb-2" value={form.destination} onChange={e=>setForm({...form,destination:e.target.value})}>
          <option value="">Choose Destination</option>
          {destinations.map(d=><option key={d.id} value={d.name}>{d.name}</option>)}
        </select>
        <select className="border p-2 w-full mb-2" value={form.transport} onChange={e=>setForm({...form,transport:e.target.value})}>
          <option value="">Choose Transport</option>
          {transports.map(t=><option key={t.id} value={t.name}>{t.type}: {t.name} (${t.price})</option>)}
        </select>
        <input type="number" min="1" className="border p-2 w-full mb-2" value={form.days} onChange={e=>setForm({...form,days:parseInt(e.target.value)})} />
        <input type="number" min="1" className="border p-2 w-full mb-2" value={form.travelers} onChange={e=>setForm({...form,travelers:parseInt(e.target.value)})} />
        <select className="border p-2 w-full mb-2" value={form.type} onChange={e=>setForm({...form,type:e.target.value})}>
          <option value="tourism">Tourism</option>
          <option value="vacation">Vacation</option>
          <option value="business">Business</option>
        </select>
        <div className="flex items-center mb-2">
          <input type="checkbox" checked={form.insurance} onChange={e=>setForm({...form,insurance:e.target.checked})} />
          <span className="ml-2">Traveler Insurance ($20 per traveler)</span>
        </div>
        <button className="bg-blue-600 text-white p-2 w-full" onClick={submit}>Confirm Booking</button>

        {itinerary && (
          <div className="mt-4 p-2 border rounded bg-gray-50">
            <h3 className="font-bold">Your Itinerary</h3>
            <p><strong>Destination:</strong> {itinerary.destination}</p>
            <p><strong>Transport:</strong> {itinerary.transport}</p>
            <p><strong>Days:</strong> {itinerary.days}</p>
            <p><strong>Travelers:</strong> {itinerary.travelers}</p>
            <p><strong>Total:</strong> ${itinerary.total}</p>
            <ul className="list-disc ml-6">
              {itinerary.activities.map((a,i)=><li key={i}>{a}</li>)}
            </ul>
            <button className="mt-2 bg-green-600 text-white p-2 w-full" onClick={downloadPDF}>Download PDF</button>
          </div>
        )}
      </div>
      <Footer />
    </div>
  );
}

export default function App() {
  return (
    <Router>
      <Routes>
        <Route path="/" element={<Home />} />
        <Route path="/destinations" element={<Destinations/>} />
        <Route path="/transports" element={<Transports/>} />
        <Route path="/operators" element={<Operators/>} />
        <Route path="/booking" element={<Booking/>} />
      </Routes>
    </Router>
  );
}
